{
  "name": "start-intl",
  "version": "0.0.0",
  "description": "Locale routing for use-intl on TanStack Start: prefixes, detection, the locale cookie and a locale-aware Link",
  "license": "MIT",
  "repository": "github:nexumAG/start-intl",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./middleware": "./dist/middleware.js",
    "./react": "./dist/react.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170",
    "@tanstack/react-start": "^1.168",
    "react": "^19.2",
    "use-intl": "^4.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.6.0",
    "@types/react": "19.2.18",
    "jsdom": "30.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "use-intl": "4.14.8",
    "vitest": "4.1.11"
  }
}
